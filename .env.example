# Template only: contains NO real secrets and is safe to commit.
# Copy this file to .env and fill in each value:
#   cp .env.example .env
# .env is listed in .gitignore, so your values stay on your machine.

# Key clients must send to /api/data (?key=...)
API_KEY=

# Database connection details used to build the /db connection string
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=

# Secret used to sign tokens from /token (a long random string)
JWT_SECRET=
